@model Dashboard
@using System.Globalization
@{ ViewData["Title"]="Calendario"; var culture=CultureInfo.GetCultureInfo("es-CO"); var first=Model.Month; var prev=first.AddMonths(-1); var next=first.AddMonths(1); var offset=((int)first.DayOfWeek+6)%7; var days=DateTime.DaysInMonth(first.Year,first.Month); var events=Model.Activities.Where(x=>x.Kind!="Apunte").ToList(); var upcoming=events.Where(x=>x.Status!="Completado" && x.Date.Date>=DateTime.Today && x.Date.Date<=DateTime.Today.AddDays(7)).ToList(); }
<header><div><p class="eyebrow">UN DÍA A LA VEZ</p><h1>Tu calendario académico</h1><p class="muted">Dale espacio a lo importante. Organiza tu próximo paso.</p></div><a class="button" asp-controller="Activities" asp-action="Edit">+ Nueva actividad</a></header>
<div class="stats"><div><span>Materias</span><strong>@Model.Subjects.Count</strong></div><div><span>Tareas pendientes</span><strong>@events.Count(x=>x.Kind=="Tarea" && x.Status!="Completado")</strong></div><div><span>Próximos 7 días</span><strong>@upcoming.Count</strong></div><div><span>Apuntes guardados</span><strong>@Model.Activities.Count(x=>x.Kind=="Apunte")</strong></div></div>
<div class="calendar-layout"><section class="calendar"><div class="monthbar"><h2>@culture.TextInfo.ToTitleCase(first.ToString("MMMM yyyy",culture))</h2><div class="actions"><a aria-label="Mes anterior" asp-route-year="@prev.Year" asp-route-month="@prev.Month">←</a><a asp-action="Index">Hoy</a><a aria-label="Mes siguiente" asp-route-year="@next.Year" asp-route-month="@next.Month">→</a></div></div><div class="week">@foreach(var d in new[]{"Lun","Mar","Mié","Jue","Vie","Sáb","Dom"}){<span>@d</span>}</div><div class="grid">
@for(var i=0;i<((offset+days+6)/7)*7;i++) { var day=i-offset+1; if(day<1 || day>days) { <div class="day outside"></div> } else { var date=first.AddDays(day-1); <div class="day @(date==DateTime.Today?"today":"")"><span class="number">@day</span>@foreach(var a in events.Where(x=>x.Date.Date==date)) { <a class="event @(a.Kind=="Examen"?"exam":"task") @(a.Status=="Completado"?"done":"")" asp-controller="Activities" asp-action="Edit" asp-route-id="@a.Id" title="@a.Title · @Model.Subjects.FirstOrDefault(x=>x.Id==a.SubjectId)?.Name"><strong>@a.Date.ToString("HH:mm") @a.Title</strong><small>@Model.Subjects.FirstOrDefault(x=>x.Id==a.SubjectId)?.Name</small></a> }</div> } }
</div><p class="legend"><span>● Tareas</span><span>● Exámenes</span></p></section><section class="reminders"><span class="badge">MANTENTE AL DÍA</span><h2>Esta semana</h2><p class="muted">Recordatorios de los próximos 7 días.</p>@foreach(var a in upcoming) { <a class="reminder" asp-controller="Activities" asp-action="Edit" asp-route-id="@a.Id"><small>@a.Kind · @a.Date.ToString("dd/MM HH:mm")</small><strong>@a.Title</strong><span>@Model.Subjects.FirstOrDefault(x=>x.Id==a.SubjectId)?.Name</span></a> }@if(upcoming.Count==0) { <p class="empty">No tienes entregas ni exámenes próximos.</p> }@{var overdue=events.Count(x=>x.Status!="Completado" && x.Date.Date<DateTime.Today);}@if(overdue>0){<p class="errors">Tienes @overdue actividad(es) vencida(s). <a asp-controller="Activities" asp-action="Index">Revisar actividades</a></p>}<a asp-controller="Subjects" asp-action="Index">Ver mis materias →</a></section></div>
