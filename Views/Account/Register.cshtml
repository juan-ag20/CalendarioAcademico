@model AccountForm
@{ ViewData["Title"] = "Crea tu cuenta"; }
<div class="auth"><p class="eyebrow">BIENVENIDO A TU ESPACIO ACADÉMICO</p><h1>Crea tu cuenta</h1><p class="muted">Organiza tus materias y llega a tiempo a cada entrega.</p><form method="post" asp-action="Register"><div asp-validation-summary="All" class="errors"></div><label>Nombre y apellido<input asp-for="Name" autocomplete="name" required/></label><label>Correo electrónico<input asp-for="Email" type="email" autocomplete="email" required/></label><label>Contraseña<input asp-for="Password" type="password" autocomplete="new-password" minlength="8" required/></label><button>Crea tu cuenta</button></form><p><a asp-action="Login">Ya tengo cuenta →</a></p></div>
