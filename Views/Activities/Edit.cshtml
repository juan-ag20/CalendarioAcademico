@model Activity
@{ ViewData["Title"]=Model.Id==0?"Nueva actividad":"Editar actividad"; var subjects=(List<Subject>)ViewBag.Subjects; }
<h1>@ViewData["Title"]</h1>
@if(subjects.Count==0) { <div class="empty">Primero debes <a asp-controller="Subjects" asp-action="Edit">crear una materia</a>.</div> } else {
<form method="post" asp-action="Edit" class="editor"><div asp-validation-summary="All" class="errors"></div><input asp-for="Id" type="hidden"/><div class="two"><label>Materia<select asp-for="SubjectId">@foreach(var s in subjects){<option value="@s.Id">@s.Name</option>}</select></label><label>Tipo<select asp-for="Kind"><option>Tarea</option><option>Examen</option><option>Apunte</option></select></label></div><label>Título<input asp-for="Title" required maxlength="150"/></label><label>Descripción o contenido<textarea asp-for="Description" rows="6"></textarea></label><div class="two"><label>Fecha y hora<input asp-for="Date" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" required/></label><label>Lugar<input asp-for="Place"/></label></div><div class="two"><label>Prioridad<select asp-for="Priority"><option>Baja</option><option>Media</option><option>Alta</option></select></label><label>Estado<select asp-for="Status"><option>Pendiente</option><option>En proceso</option><option>Completado</option></select></label></div><p class="muted">En los apuntes, la fecha indica cuándo se registran. Prioridad y estado se utilizan en tareas y exámenes.</p><div class="actions"><button>Guardar actividad</button><a asp-action="Index">Cancelar</a></div></form>
}
