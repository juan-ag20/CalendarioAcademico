@model List<Activity>
@{ ViewData["Title"]="Actividades y apuntes"; var subjects=(List<Subject>)ViewBag.Subjects; }
<header><div><p class="eyebrow">PLANIFICA Y AVANZA</p><h1>Actividades y apuntes</h1></div><a class="button" asp-action="Edit" asp-route-subjectId="@ViewBag.SubjectId">+ Nueva actividad</a></header>
<form method="get" class="filters"><label>Materia<select name="subjectId"><option value="">Todas las materias</option>@foreach(var s in subjects) { <option value="@s.Id" selected="@(ViewBag.SubjectId == s.Id)">@s.Name</option> }</select></label><label>Tipo<select name="kind"><option value="">Todos los tipos</option>@foreach(var k in new[]{"Tarea","Examen","Apunte"}) { <option selected="@(ViewBag.Kind == k)">@k</option> }</select></label><button>Filtrar</button><a asp-action="Index">Limpiar</a></form>
<div class="cards">@foreach(var a in Model) { <article class="card"><span class="badge">@a.Kind · @subjects.FirstOrDefault(x=>x.Id==a.SubjectId)?.Name</span><h2>@a.Title</h2><p class="muted">@a.Date.ToString("dd/MM/yyyy HH:mm") · @a.Place</p><p class="note">@a.Description</p>@if(a.Kind!="Apunte") { <p>@a.Status · Prioridad @a.Priority</p> }<div class="actions"><a asp-action="Edit" asp-route-id="@a.Id">Editar</a><form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar esta actividad?')"><input name="id" type="hidden" value="@a.Id"/><button class="danger">Eliminar</button></form></div></article> }</div>
@if(Model.Count==0) { <div class="empty">No hay actividades para esta selección.</div> }
