@model List<Subject>
@{ ViewData["Title"]="Mis materias"; }
<header><div><p class="eyebrow">TU SEMESTRE</p><h1>Mis materias</h1><p class="muted">Un espacio para cada asignatura.</p></div><a class="button" asp-action="Edit">+ Nueva materia</a></header>
<div class="cards">@foreach(var s in Model) { <article class="card"><span class="badge">MATERIA</span><h2>@s.Name</h2><p>@s.Teacher</p><p class="muted">@s.Schedule · @s.Room</p><p>@s.Description</p><div class="actions"><a asp-controller="Activities" asp-action="Index" asp-route-subjectId="@s.Id">Abrir materia →</a><a asp-action="Edit" asp-route-id="@s.Id">Editar</a><form asp-action="Delete" method="post" onsubmit="return confirm('¿Eliminar la materia y todas sus actividades y apuntes?')"><input type="hidden" name="id" value="@s.Id"/><button class="danger">Eliminar</button></form></div></article> }</div>
@if(Model.Count==0) { <div class="empty">Agrega tu primera materia para empezar a organizar tu semestre.</div> }
